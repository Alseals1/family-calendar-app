# Local Supabase values: run `npx supabase start`, then `npx supabase status -o env`
# and copy API_URL and ANON_KEY here. Use only the local stack, never a hosted project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Resend SMTP credentials are set in the Supabase dashboard (production only), never in this app.
